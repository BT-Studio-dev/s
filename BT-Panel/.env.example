# BT Panel — disposable integration-test config; register a test user yourself.
DATABASE_URL=mysql://btpanel:localdev@127.0.0.1:3306/btpanel
COOKIE_SECURE=false
PORT=3001

# Password reset email — uses Nodemailer. Leave SMTP_HOST empty to fall back
# to the dev "console transport" which logs the message and returns a
# previewUrl in the API response (useful in this sandbox where SMTP isn't
# reachable). When the panel is deployed for real, set:
#   SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, SMTP_FROM
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BT Panel <no-reply@btpanel.local>"

# Public URL used to build reset links inside the email. Override to your
# real domain (e.g. https://panel.example.com) in production.
PUBLIC_BASE_URL=http://localhost:3001
