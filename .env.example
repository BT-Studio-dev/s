# ---------------------------------------------------------------------------
# BT Panel — example environment
#
#   cp .env.example .env      # then edit the values below
#
# Never commit the filled-in .env file; it is ignored by .gitignore.
# ---------------------------------------------------------------------------

# ===========================================================================
# Next.js panel (required)
# ===========================================================================

# MySQL / MariaDB connection string used by the Next.js app and Drizzle ORM.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://btpanel:localdev@127.0.0.1:3306/btpanel

# Port the Next.js server listens on. The managed container expects 3000.
PORT=3000

# Canonical public HTTPS origin of the panel. Required for Google sign-in and
# used to build password-reset links (never trusted from the request Host
# header). Leave blank for local HTTP development.
PUBLIC_BASE_URL=

# Force the session cookie Secure flag (true|false). Leave unset to auto-detect:
# Secure in production, plain over http://localhost.
# COOKIE_SECURE=false

# Optional: name shown before settings are seeded in the database.
# PANEL_NAME=BT Panel

# ===========================================================================
# Email (optional)
# ===========================================================================
# SMTP configured in the admin Settings UI takes priority. These environment
# values are only used when the database has no SMTP host configured.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=BT Panel <no-reply@btpanel.local>

# ===========================================================================
# Legacy Mpanel engine (optional)
# ===========================================================================
# Only needed for `npm run legacy:start` / `npm run setup` (the standalone
# Express engine in src/index.js). The Next.js panel above does not read these.
# PANEL_NAME=Mpanel
# NODE_ENV=production
# PORT_WEB=3001
# PORT_API=3003
# PORT_SFTP=3004
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES_IN=7d
# CURSEFORGE_API_KEY=
# CURSEFORGE_BASE_URL=https://api.curseforge.com/v1
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=btpanel
# DB_PASSWORD=change-me
# DB_NAME=btpanel
# SERVER_DB_HOST=127.0.0.1
# SERVER_DB_PORT=3306
# SERVER_DB_USER=root
# SERVER_DB_PASSWORD=change-me
# SERVER_DB_DATABASE=mydatabase
